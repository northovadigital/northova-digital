{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cakeybakey",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cakeybakey"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "cakeybakey_db",
			"database_name": "cakeybakey-db",
			"database_id": "40d2c203-755a-4afb-8b10-3ab578b10cde",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "cakeybakey-products",
			"binding": "cakeybakey_products",
			"remote": true
		}
	]
}